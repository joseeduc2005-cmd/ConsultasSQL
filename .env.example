# ═══════════════════════════════════════════════════════════════════════
#  Variables del docker-compose.yml  (copie a .env y rellene)
#
#  Este fichero es el ejemplo y SÍ se versiona. El .env de verdad NO:
#  está en .gitignore. La contraseña de la base de conocimiento vivía
#  escrita dentro del docker-compose.yml, que sí está versionado, así que
#  estaba en el repositorio y era «admin123».
# ═══════════════════════════════════════════════════════════════════════

# Contraseña del PostgreSQL interno (la base knowledge_base).
# Obligatoria: compose se niega a arrancar si falta, a propósito — es mejor
# que arrancar con un valor por defecto que nadie llega a cambiar.
POSTGRES_PASSWORD=

# Cada cuántas horas se saca copia de la base de conocimiento.
RESPALDO_CADA_HORAS=24

# Cuántas copias se conservan antes de ir borrando las más viejas.
RESPALDO_CONSERVAR=14

# Ruta del .env del backend que compose carga en el contenedor.
BACKEND_ENV_PATH=./backend/.env
