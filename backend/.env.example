PORT=3001
NODE_ENV=development
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRE=7d

# Multi-base
# Registrar multiples bases por archivo JSON es lo recomendado.
# La base principal del backend tambien debe vivir ahi con primary=true.
# Si no se define, el backend intentara leer ./config/multidb.databases.json.
MULTI_DB_CONFIG_FILE=./config/multidb.databases.json
# Fallback legacy opcional solo para compatibilidad temporal:
# DATABASE_URL=postgresql://user:password@localhost:5432/boton_pago
# Alternativa legacy: JSON inline en una sola linea
# MULTI_DB_CONFIG={"databases":[]}

# Fuerza que /api/query use resolucion distribuida cuando detecta consultas multi-entidad
FORCE_DISTRIBUTED_MULTI_ENTITY=true

# Debug / metricas tecnicas del motor de consulta
DEBUG_QUERY_ENGINE=false

# Seguridad API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
MAX_API_ROWS=100
SQL_QUERY_TIMEOUT_MS=8000

# ─── Modulo de soporte (tickets, diagnosticos, vigilancia) ───────────────────
# La conexion a Oracle se toma de la entrada "oracle" de multidb.databases.json.
# Para usar otra entrada, o un usuario dedicado de solo lectura, descomentar:
# SOPORTE_ORACLE_DB_ID=oracle
# SOPORTE_ORACLE_USUARIO=soporte_lectura
# SOPORTE_ORACLE_CLAVE=
# SOPORTE_ORACLE_CONEXION=172.17.211.71:1521/desajab.jardinazuayo.fin.ec
SOPORTE_ORACLE_MAX_FILAS=500
SOPORTE_ORACLE_TIMEOUT_MS=20000
# Segundos para dar por perdido el intento de conexion. Con Oracle inalcanzable el
# driver esperaria ~20 s por intento y arrastraria a /api/soporte/estado con el.
SOPORTE_ORACLE_CONECTAR_TIMEOUT_S=6

# Fuerza datos ficticios sin tocar Oracle (util para desarrollo y demos)
# SOPORTE_MODO=demo

# Puente con el motor de consultas: siembra el vocabulario de la Biblioteca SQL en
# semantic_learning la primera vez que arranca. "off" lo deja solo bajo demanda,
# desde POST /api/soporte/vocabulario.
SOPORTE_VOCABULARIO=auto

# Vigilancia programada: arranca APAGADA. Ponerla en "on" hace que los 6 monitores
# consulten Oracle periodicamente en segundo plano.
VIGILANCIA=off

# Umbrales usados por los diagnosticos de acceso
MAX_INTENTOS_PIN=3
MAX_INTENTOS_CLAVE=3
LIMITE_REPORTE_TRANSACCIONES=300
