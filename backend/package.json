{
  "name": "boton-pago-core",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Botón Pago - Clean Architecture",
  "main": "src/app.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "node src/app.js",
    "build": "tsc",
    "start": "node src/app.js",
    "test": "node --test --experimental-strip-types src/dominio/sql/guardas.test.js src/dominio/acceso/roles.test.js src/dominio/red/salida.test.js src/dominio/bases/resolucion.test.js src/dominio/texto/normalizar.test.js src/dominio/scripts/validacion.test.js src/soporte/soporte.test.ts",
    "test:soporte": "node --test src/soporte/soporte.test.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "clean-architecture"
  ],
  "author": "Team",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.1",
    "oracledb": "^6.10.0",
    "pg": "^8.11.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.55.0",
    "jest": "^30.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "oracledb",
      "unrs-resolver",
      "esbuild",
      "sharp"
    ]
  }
}
