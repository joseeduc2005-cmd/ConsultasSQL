# Configuración del frontend. Copie este archivo a .env.local y ajuste los valores:
#
#   cp frontend/.env.example frontend/.env.local
#
# .env.local no se versiona porque lleva secretos.

# Backend de ConsultasSQL. En local, el puerto donde corre `node src/app.js`.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002

# Base de conocimiento. Mismas credenciales que la entrada `pg_main` de
# backend/config/multidb.databases.json.
DATABASE_URL=postgresql://USUARIO:CAMBIAR@localhost:5432/knowledge_base

# Firma de sesión. Cámbielo por un valor largo y propio antes de desplegar.
JWT_SECRET=CAMBIAR

NODE_ENV=development

# Sistema de tickets de la organización, si lo hay.
#
# Con esto, al registrar un caso con una referencia numérica se enlaza solo al caso
# original. Déjelo vacío o quítelo si no usa ninguno: sin él no se arma ningún enlace,
# que es lo correcto cuando los casos no vienen todos del mismo sitio.
# Ejemplo: NEXT_PUBLIC_TICKETS_URL=https://tickets.suempresa.com/ver?id=
NEXT_PUBLIC_TICKETS_URL=
